---
import type { Page } from "astro";

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;

const hasPreviousPage = page.url.prev;
const hasNextPage = page.url.next;
const currentPage = page.currentPage;
---

<section class="bg-background px-4 pb-16 pt-2">
  <nav
    aria-label="Blog pagination"
    class="mx-auto flex w-fit max-w-full items-center justify-center gap-1 rounded-full border border-border bg-surface/90 p-1 text-sm font-bold text-default shadow-[var(--shadow-card)] backdrop-blur"
  >
    {hasPreviousPage ? (
      <a
        href={`${import.meta.env.BASE_URL}/blogs/${currentPage - 1}`}
        class="flex h-10 min-w-[5.75rem] items-center justify-center rounded-full px-4 transition-colors hover:bg-offset focus:outline-none focus:ring-2 focus:ring-secondary/70"
      >
        Previous
      </a>
    ) : (
      <span
        class="flex h-10 min-w-[5.75rem] cursor-not-allowed items-center justify-center rounded-full px-4 text-offset opacity-60"
        aria-disabled="true"
      >
        Previous
      </span>
    )}

    <span
      class="flex h-10 min-w-10 items-center justify-center rounded-full bg-offset px-3"
      aria-current="page"
    >
      {currentPage}
    </span>

    {hasNextPage ? (
      <a
        href={`${import.meta.env.BASE_URL}/blogs/${currentPage + 1}`}
        class="flex h-10 min-w-[5.75rem] items-center justify-center rounded-full px-4 transition-colors hover:bg-offset focus:outline-none focus:ring-2 focus:ring-secondary/70"
      >
        Next
      </a>
    ) : (
      <span
        class="flex h-10 min-w-[5.75rem] cursor-not-allowed items-center justify-center rounded-full px-4 text-offset opacity-60"
        aria-disabled="true"
      >
        Next
      </span>
    )}
  </nav>
</section>
